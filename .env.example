# EmailJS Configuration
# Récupérez ces clés sur https://www.emailjs.com/

# Votre Public Key (trouvée dans EmailJS Dashboard -> Account)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Votre Service ID (trouvée dans EmailJS Dashboard -> Email Services)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Votre Template ID (trouvée dans EmailJS Dashboard -> Email Templates)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
